{
  "name": "mail-launch-video",
  "version": "1.0.0",
  "description": "The 19-second launch film and repository artwork for Mail.",
  "repository": "github:bradymoore1010/mail",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "@remotion/media": "4.0.520",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.520",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "render": "remotion render MailLaunch out/mail-launch.mp4 --codec=h264",
    "render:hero": "remotion still MailHero out/mail-hero.png",
    "render:social": "remotion still MailSocial out/mail-social.png",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
